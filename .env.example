# ============ 复制为 .env 后按需修改（不配置也能跑：默认离线 Mock 模式） ============

# ---------- 大模型（OpenAI 兼容接口，通义/讯飞/DeepSeek/vLLM/Ollama 均可） ----------
# 留空则使用内置 MockLLM（离线、纯抽取式回答，用于演示与测试）
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1536
LLM_TIMEOUT=60

# ---------- 向量化 ----------
# auto: 配置了 EMBEDDING_API_KEY 就走接口，否则用内置 hash 向量（离线可用）
# hash / api / sentence-transformers
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DIM=512
ST_MODEL=BAAI/bge-small-zh-v1.5

# ---------- 存储 ----------
VECTOR_BACKEND=sqlite
# DATA_DIR=./data

# ---------- 切片与检索 ----------
CHUNK_SIZE=600
CHUNK_OVERLAP=80
# 文档级自动去重：SimHash 汉明距离阈值 + 长度差异容忍度
DOC_DEDUP_DISTANCE=3
DOC_DEDUP_LENGTH_TOLERANCE=0.02
# 命中重复文档时的策略：skip 跳过 / keep 照常入库
DUPLICATE_POLICY=skip
RETRIEVAL_TOP_K=6
SEMANTIC_WEIGHT=0.6
KEYWORD_WEIGHT=0.4
# 绝对相关度阈值：max(向量余弦相似度, 查询词覆盖率)。
# 低于该值即判定「知识库中没有相关资料」，直接兜底回答，避免大模型编造。
MIN_RELEVANCE_SCORE=0.18
# 精排：none 关闭 / lexical 词面精排（零依赖，默认降级到这里）/ cross-encoder 句对重排
# auto 表示「装了 sentence-transformers 就用重模型，否则用词面精排」
RERANK_PROVIDER=auto
RERANK_TOP_N=20
# 精排分与召回分的融合权重：越大越看重词面命中
RERANK_WEIGHT=0.4
# RERANK_MODEL=BAAI/bge-reranker-base

# ---------- 网页导入安全 ----------
# 单个网页最大体积（字节）与最多跟随的重定向次数
URL_FETCH_MAX_BYTES=10485760
URL_FETCH_MAX_REDIRECTS=3
# 默认禁止抓取回环 / 私网 / 链路本地地址（防 SSRF）；确需导入内网 wiki 再设为 true
URL_ALLOW_PRIVATE_HOSTS=false

# ---------- Agent ----------
AGENT_MAX_SUB_QUESTIONS=4
AGENT_MAX_ROUNDS=2
AGENT_LLM_PLANNER=true

# ---------- 自我反思闭环（Self-Reflection） ----------
# 初次生成答案后自动校验：发现幻觉风险或信息缺口 → 改写 Query 补充检索 → 重新生成
REFLECTION_ENABLED=true
# 最多补充检索几轮（0 = 只做一次自检，不迭代）
REFLECTION_MAX_ROUNDS=2
# 引用依据度低于该值即判定存在幻觉风险（0~1，调高更严格）
REFLECTION_MIN_GROUNDED=0.8
# 问题信息点被检索覆盖的最低比例，低于该值说明检索没打中要点（0~1）
REFLECTION_MIN_COVERAGE=0.6
# 每轮最多改写几条补充检索 Query
REFLECTION_MAX_QUERIES=3
# 反思环节时间预算（毫秒），超出立即停止迭代，防止无限检索
REFLECTION_TIME_BUDGET_MS=6000

# ---------- 记忆 ----------
SHORT_TERM_TURNS=6
LONG_TERM_MAX_ITEMS=60

# ---------- 服务 ----------
API_HOST=127.0.0.1
API_PORT=8000
# 填写后所有 /api/* 接口都要求 Authorization: Bearer <token> 或 X-API-Token 头（/api/health 除外）
# API_TOKEN=
# 允许跨域访问的来源，逗号分隔；* 表示不限制（此时不会下发凭据，浏览器规范限制）
API_CORS_ORIGINS=*
